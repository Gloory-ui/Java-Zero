# Скопируй в .env.local и заполни. .env.local в git не попадает.

# Supabase: Project Settings → API. Нужен только публичный ключ (anon или publishable).
# Ключ service_role в приложение не кладём никогда.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Адрес сайта для метаданных и ссылок
NEXT_PUBLIC_SITE_URL=https://java-zero.onrender.com

# true только на боевом сайте: превью не должны попадать в поиск
SITE_INDEX=false

# AI-ментор: ключ Gemini из Google AI Studio. Только сервер, без NEXT_PUBLIC_.
GEMINI_API_KEY=
# Необязательно: свой порядок моделей через запятую (первая, при перегрузке — следующая)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
